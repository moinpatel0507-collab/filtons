# Copy this file to .env.local for running on your computer.
# On Vercel, add the same three names under Project → Settings → Environment Variables.

# Project URL (Supabase → Project Settings → API). No /rest/v1/ on the end.
NEXT_PUBLIC_SUPABASE_URL=https://ajcpompnwwktxeaqvsjm.supabase.co

# The "anon" / "publishable" key. Safe to be public: the database rules protect the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-anon-key-here

# The "service_role" / "secret" key. SERVER ONLY. Never share it, never commit it.
# Used only to create staff logins, block deactivated logins and reset 2FA.
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here
